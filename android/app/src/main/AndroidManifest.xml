<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Accès au serveur WinPlus. Sans cette ligne, seules les versions de
         développement (debug, profile) avaient le réseau : la version de
         production ne pouvait joindre aucune API. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Détection de l'état du réseau (mode hors ligne, connectivity_plus). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Dictée vocale de WinAI (speech_to_text) : demandée à la première
         dictée, jamais au lancement. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Notifications application fermée, sans Firebase (lot 2) : service au
         premier plan qui garde ouvert le flux ntfy. Android 14+ exige le type
         « remoteMessaging » et sa permission. Les permissions générales
         (FOREGROUND_SERVICE, POST_NOTIFICATIONS, RECEIVE_BOOT_COMPLETED,
         WAKE_LOCK) viennent des manifestes des bibliothèques. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING"/>
    <!-- Déverrouillage de l'application par empreinte ou visage (local_auth). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Sauvegarde Android : jetons et leçons chiffrées exclus
         (res/xml/backup_rules.xml et data_extraction_rules.xml). -->
    <application
        android:label="WinPlus"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Liens du site ouverts dans l'application (App Links, lot 2) :
                 lien « mot de passe oublié » reçu par e-mail, lien d'un cours
                 en direct. Vérifiés par
                 https://winplus.cm/.well-known/assetlinks.json (empreinte de
                 la clé de signature). Traités par lib/services/deep_links.dart. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="winplus.cm"/>
                <data android:host="www.winplus.cm"/>
                <data android:host="integration.winplus.cm"/>
                <data android:pathPrefix="/reset-password/"/>
                <!-- Lot 9.4 : lien partagé d'un cours en direct
                     (/visio/seance/{id}, /visio/tutorat/{id}). -->
                <data android:pathPrefix="/visio/"/>
                <!-- Fiche d'une séance en direct partagée (/sessions/{id}). -->
                <data android:pathPrefix="/sessions/"/>
            </intent-filter>
            <!-- Les liens passent par app_links, pas par le routage nommé de
                 Flutter (l'application n'a pas de routes nommées). -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false"/>
        </activity>
        <!-- Écoute des notifications (flutter_foreground_task) : ne pas changer
             le nom du service. Relancée au démarrage du téléphone. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="remoteMessaging"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lot 9.5 (17.17) : selfie de vérification pris avec l'appareil photo
             (image_picker, intention de capture : aucune permission CAMERA
             n'est nécessaire, l'application photo du téléphone prend la vue). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <!-- Dictée vocale : service de reconnaissance du téléphone. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- url_launcher : ouvrir une page du site dans le navigateur
             (Android 11+ exige de déclarer les intentions interrogées). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Lecture a voix haute (flutter_tts) : le moteur de synthese doit etre
             visible depuis Android 11, sinon aucune voix n'est trouvee. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
    <!-- Appareil photo facultatif : l'application reste installable sans caméra
         (le choix d'un fichier reste possible pour le selfie). -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
</manifest>
