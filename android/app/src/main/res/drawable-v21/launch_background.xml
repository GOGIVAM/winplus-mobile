<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de démarrage natif (avant Android 12) : fond vert profond de la
     marque et logo dans un disque blanc, affichés avant que Flutter dessine
     sa première image, à la place de l'ancien écran blanc. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/winplus_abyss" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
