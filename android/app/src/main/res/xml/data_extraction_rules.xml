<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde dans le cloud et transfert vers un nouveau téléphone
     (Android 12 et plus) : mêmes exclusions que backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="root" path="app_flutter/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="root" path="app_flutter/" />
    </device-transfer>
</data-extraction-rules>
