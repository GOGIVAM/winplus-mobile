<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fenêtre affichée au lancement, jusqu'à la première image de Flutter :
         fond vert profond et logo (drawable/launch_background.xml). -->
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Fond de la fenêtre derrière Flutter pendant son démarrage : le même
         vert, pour éviter un éclair blanc entre le logo et l'application. -->
    <style name="NormalTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/winplus_abyss</item>
    </style>
</resources>
