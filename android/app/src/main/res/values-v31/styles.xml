<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 et plus : l'écran de démarrage est dessiné par le système.
         Fond vert profond, logo dans le disque blanc du système. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/winplus_abyss</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/winplus_abyss</item>
    </style>
</resources>
